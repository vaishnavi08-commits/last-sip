# Copy this file to .env.local and fill in real values there.
# .env.local is already in .gitignore — it will never be committed.
#
# Where to find these: Supabase dashboard > Project Settings > API
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon public" key
#
# Both are safe to expose in the browser bundle by Supabase's own design —
# they only work together with the row-level security rules on each table.
# The service role key (needed in a later slice) is NOT safe to expose and
# must never go in a file with NEXT_PUBLIC_ in its name.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
